# Cloudflare Pages Functions runtime variables.
# Do not commit real credentials or private webhook URLs.
# Demo/no-delivery mode. The form returns success without forwarding inquiries.
INQUIRY_LOG_ONLY=true
# Optional: send inquiries to a webhook, for example Make/Zapier/CRM.
# INQUIRY_WEBHOOK_URL=
# Optional: send inquiries by email through Resend.
# RESEND_API_KEY=
# INQUIRY_TO_EMAIL=neoplastpl@info.pl
# INQUIRY_FROM_EMAIL=NeoPlasty <noreply@example.pl>